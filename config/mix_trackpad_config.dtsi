/*
 * Tunable parameters for Mix keyboard trackpad configuration.
 * Adjust these values to change mouse and scroll behavior.
 *
 * Format: NUMERATOR / DENOMINATOR
 *   Higher ratio = faster movement
 *   Lower ratio = slower, more precise movement
 */

/* Scroll layers: which layers activate scroll mode.
 * Layer 4 does not exist in the keymap (only layers 0-3), so scroll never
 * triggers — the trackpad moves the mouse on every layer. Kept as a
 * placeholder so scroll can be re-enabled by pointing this at 0-3.
 */
#define MIX_SCROLL_LAYERS 4

/* Cirque trackpad sensitivity: "1x" (default), "2x", "4x" */
#define MIX_CIRQUE_SENSITIVITY "2x"

/* Mouse pointer speed (zip_xy_scaler ratio):
 *   5/2 = fast, 2/1 = medium, 3/2 = smooth (slightly slower), 1/1 = slow
 *   Lower ratio = slower pointer and finer/smoother stepping.
 */
#define MIX_MOUSE_SPEED_NUM 3
#define MIX_MOUSE_SPEED_DEN 2

/* Scroll speed: 1/6 (default @1x), 1/30 (@2x slow), 1/20 (@2x medium) */
#define MIX_SCROLL_SPEED_NUM 1
#define MIX_SCROLL_SPEED_DEN 40
